# ─── Firebase Config ────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase_config/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=smart-sanitation-nagpur.appspot.com
FIREBASE_DATABASE_URL=https://smart-sanitation-nagpur-default-rtdb.firebaseio.com

# ─── Google Maps API ────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ─── Flask Config ───────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=development
FLASK_PORT=5000

# ─── AI Model Config ────────────────────────────────────────────────────────────
MODEL_PATH=models/hygiene_classifier.h5
YOLO_WEIGHTS=models/yolov8_toilet.pt
CONFIDENCE_THRESHOLD=0.45

# ─── App Config ─────────────────────────────────────────────────────────────────
CITY=Nagpur
CITY_LAT=21.1458
CITY_LNG=79.0882
